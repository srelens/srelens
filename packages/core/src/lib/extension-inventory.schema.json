{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "arguments",
        "inputs",
        "name",
        "target",
        "title"
      ],
      "type": "object"
    },
    "Contributions": {
      "additionalProperties": false,
      "properties": {
        "detailLinks": {
          "items": {
            "$ref": "#/definitions/DetailLink"
          },
          "type": "array"
        },
        "detailTabs": {
          "items": {
            "$ref": "#/definitions/DetailTab"
          },
          "type": "array"
        },
        "pages": {
          "items": {
            "$ref": "#/definitions/Page"
          },
          "type": "array"
        }
      },
      "required": [
        "detailLinks",
        "detailTabs",
        "pages"
      ],
      "type": "object"
    },
    "Dashboard": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "anyOf": [
            {
              "$ref": "#/definitions/DashboardEvents"
            },
            {
              "type": "null"
            }
          ]
        },
        "pages": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "pages"
      ],
      "type": "object"
    },
    "DashboardEvents": {
      "additionalProperties": false,
      "properties": {
        "apiGroups": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "capability": {
          "type": "string"
        }
      },
      "required": [
        "apiGroups",
        "capability"
      ],
      "type": "object"
    },
    "DetailLink": {
      "additionalProperties": false,
      "description": "An entry in a resource detail view's app links menu that opens a read-only results panel. It never writes to the cluster; the name `rowActions` is reserved for declared mutations.",
      "properties": {
        "capability": {
          "type": "string"
        },
        "forKinds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "capability",
        "forKinds",
        "id",
        "title"
      ],
      "type": "object"
    },
    "DetailTab": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": "string"
        },
        "forKinds": {
          "description": "Qualified Kubernetes kinds, e.g. argoproj.io/Application.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "capability",
        "forKinds",
        "id",
        "title"
      ],
      "type": "object"
    },
    "Installed": {
      "additionalProperties": false,
      "properties": {
        "contexts": {
          "description": "The kubeconfig context names the app is enabled for; `None` is every cluster.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "grants": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "history": {
          "description": "The versions this one replaced, newest first, at most [`KEPT_VERSIONS`].",
          "items": {
            "$ref": "#/definitions/PreviousVersion"
          },
          "type": "array"
        },
        "installedAt": {
          "description": "When this version was installed, in seconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "manifest": {
          "$ref": "#/definitions/Manifest"
        },
        "quarantined": {
          "description": "Why this host refused to trust the stored entry when loading it. Recomputed on every read, reported to the UI, and never written to disk.",
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "settings": {
          "additionalProperties": true,
          "type": "object"
        },
        "signatureProof": {
          "anyOf": [
            {
              "$ref": "#/definitions/SignatureProof"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/definitions/Source"
        }
      },
      "required": [
        "enabled",
        "grants",
        "history",
        "installedAt",
        "manifest",
        "revision",
        "settings",
        "source"
      ],
      "type": "object"
    },
    "Manifest": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "description": "Editor metadata: the JSON Schema the manifest is written against. The host ignores it; it is the one key allowed that is not part of the contract.",
          "type": [
            "string",
            "null"
          ]
        },
        "capabilities": {
          "items": {
            "$ref": "#/definitions/Binding"
          },
          "type": "array"
        },
        "contributions": {
          "$ref": "#/definitions/Contributions"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ManifestKind"
        },
        "name": {
          "type": "string"
        },
        "permissions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "srelensApiVersion": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "capabilities",
        "contributions",
        "id",
        "kind",
        "name",
        "permissions",
        "srelensApiVersion",
        "version"
      ],
      "type": "object"
    },
    "ManifestKind": {
      "description": "Only data is executable in this first host. Code-bearing manifests must go through the future sandboxed runtime, never through a permissive fallback.",
      "enum": [
        "declarative"
      ],
      "type": "string"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": "string"
        },
        "dashboard": {
          "anyOf": [
            {
              "$ref": "#/definitions/Dashboard"
            },
            {
              "type": "null"
            }
          ]
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "statusColumns": {
          "anyOf": [
            {
              "$ref": "#/definitions/StatusColumns"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "capability",
        "id",
        "title"
      ],
      "type": "object"
    },
    "PreviousVersion": {
      "additionalProperties": false,
      "description": "A version an update replaced, kept so it can be restored.",
      "properties": {
        "grants": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "installedAt": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "manifest": {
          "$ref": "#/definitions/Manifest"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "signatureProof": {
          "anyOf": [
            {
              "$ref": "#/definitions/SignatureProof"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/definitions/Source"
        }
      },
      "required": [
        "grants",
        "installedAt",
        "manifest",
        "revision",
        "source"
      ],
      "type": "object"
    },
    "SignatureProof": {
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "type": "string"
        },
        "signature": {
          "items": {
            "format": "uint8",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "manifest",
        "signature"
      ],
      "type": "object"
    },
    "Source": {
      "description": "Where an installed version came from. The host decides: `catalog` means the exact bytes of a release listed in the cached catalog, whoever submitted them.",
      "enum": [
        "local",
        "catalog"
      ],
      "type": "string"
    },
    "StatusColumns": {
      "additionalProperties": false,
      "properties": {
        "progressing": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ready": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "suspended": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "ready"
      ],
      "type": "object"
    }
  },
  "properties": {
    "nextRevision": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "plugins": {
      "items": {
        "$ref": "#/definitions/Installed"
      },
      "type": "array"
    },
    "schemaVersion": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "nextRevision",
    "plugins",
    "schemaVersion"
  ],
  "title": "Inventory",
  "type": "object"
}
