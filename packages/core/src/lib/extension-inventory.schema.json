{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ActionBinding": {
      "additionalProperties": false,
      "description": "One declared mutation: a host action primitive, the reader binding whose kind it acts on, the arguments that fix what it writes, and what must be true of the object before it is written.\n\nFlux and Argo CD declare their actions using this contract in API 0.3.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "description": "What this action writes, fixed at install time.",
          "type": "object"
        },
        "availableWhen": {
          "description": "What must be true of the object for the control to be offered. The same predicates, asked by the surface rather than by the cluster request, so a person is not shown a button whose refusal is already known.\n\nDisplay only, and deliberately so: an app that needs a condition *enforced* declares it in `preconditions`, where the host is what checks it. A surface can be out of date; the fresh GET cannot.",
          "items": {
            "$ref": "#/definitions/Predicate"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "preconditions": {
          "description": "What must be true of the object for the write to be sent. Evaluated by the host against the fresh GET the primitive already performs, before the patch; a predicate that does not hold refuses the request and the operator is told this predicate's `reason`.\n\nThese add refusals. The host's own guards — an object being deleted, a UID or `resourceVersion` that has moved — run first and are not something a manifest can reach.",
          "items": {
            "$ref": "#/definitions/Predicate"
          },
          "type": "array"
        },
        "resource": {
          "description": "The name of a reader binding in `capabilities`. The action acts on that binding's kind and on no other.",
          "type": "string"
        },
        "target": {
          "description": "A host action primitive, e.g. `k8s.annotate`.",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "arguments",
        "name",
        "resource",
        "target",
        "title"
      ],
      "type": "object"
    },
    "Badge": {
      "additionalProperties": false,
      "description": "A word on a built-in row. Without a `join`, the rules read the row's own `.metadata`; with one, they read the joined custom resource. The first rule that holds is the badge; when none does there is no badge.",
      "properties": {
        "forKinds": {
          "description": "Qualified built-in kinds, e.g. `apps/Deployment`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "join": {
          "description": "A declared join whose matched resource the rules read.",
          "type": [
            "string",
            "null"
          ]
        },
        "rules": {
          "items": {
            "$ref": "#/definitions/StatusRule"
          },
          "type": "array"
        }
      },
      "required": [
        "forKinds",
        "id",
        "rules"
      ],
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "arguments",
        "inputs",
        "name",
        "target",
        "title"
      ],
      "type": "object"
    },
    "ColumnFormat": {
      "enum": [
        "text",
        "number",
        "status",
        "badge",
        "date",
        "duration"
      ],
      "type": "string"
    },
    "ColumnSource": {
      "additionalProperties": false,
      "properties": {
        "join": {
          "type": [
            "string",
            "null"
          ]
        },
        "jsonPath": {
          "type": "string"
        }
      },
      "required": [
        "jsonPath"
      ],
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "One question about one value, without a sentence to say when it fails.\n\nA [`Predicate`] is a condition plus the reason an operator is told when it does not hold. A status rule (#541) asks which of its rules describes an object; nobody is refused, so there is no reason to give — but the operators, the paths and the evaluation are these, and are this code:\n\n```json {\"jsonPath\": \".spec.suspend\", \"equals\": true} ```",
      "properties": {
        "absent": {
          "description": "`true`: the value at `jsonPath` must be unset or null.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "equals": {
          "description": "The value at `jsonPath` must equal this literal."
        },
        "jsonPath": {
          "description": "The value this condition asks about, in the grammar [`resolve`] documents.",
          "type": "string"
        },
        "notEquals": {
          "description": "The value at `jsonPath` must not equal this literal. An unset field is not equal to anything, so this holds when it is absent."
        },
        "present": {
          "description": "`true`: the value at `jsonPath` must be set and not null.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "jsonPath"
      ],
      "type": "object"
    },
    "Contributions": {
      "additionalProperties": false,
      "properties": {
        "badges": {
          "description": "Words an app puts on built-in rows, from the row's metadata or from a joined resource (#541).",
          "items": {
            "$ref": "#/definitions/Badge"
          },
          "type": "array"
        },
        "detailLinks": {
          "items": {
            "$ref": "#/definitions/DetailLink"
          },
          "type": "array"
        },
        "detailPanels": {
          "items": {
            "$ref": "#/definitions/DetailPanel"
          },
          "type": "array"
        },
        "detailTabs": {
          "items": {
            "$ref": "#/definitions/DetailTab"
          },
          "type": "array"
        },
        "joins": {
          "items": {
            "$ref": "#/definitions/Join"
          },
          "type": "array"
        },
        "pages": {
          "items": {
            "$ref": "#/definitions/Page"
          },
          "type": "array"
        },
        "statusResolvers": {
          "description": "What status an app's custom resources have (#541). Replaces `pages[].statusColumns`, which is deprecated but still accepted in 0.3.",
          "items": {
            "$ref": "#/definitions/StatusResolver"
          },
          "type": "array"
        },
        "tableColumns": {
          "items": {
            "$ref": "#/definitions/TableColumn"
          },
          "type": "array"
        }
      },
      "required": [
        "detailLinks",
        "detailTabs",
        "pages"
      ],
      "type": "object"
    },
    "Dashboard": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "anyOf": [
            {
              "$ref": "#/definitions/DashboardEvents"
            },
            {
              "type": "null"
            }
          ]
        },
        "pages": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "pages"
      ],
      "type": "object"
    },
    "DashboardEvents": {
      "additionalProperties": false,
      "properties": {
        "apiGroups": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "capability": {
          "type": "string"
        }
      },
      "required": [
        "apiGroups",
        "capability"
      ],
      "type": "object"
    },
    "DetailField": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "anyOf": [
            {
              "$ref": "#/definitions/ColumnFormat"
            },
            {
              "type": "null"
            }
          ]
        },
        "join": {
          "type": [
            "string",
            "null"
          ]
        },
        "jsonPath": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "jsonPath",
        "label"
      ],
      "type": "object"
    },
    "DetailLink": {
      "additionalProperties": false,
      "description": "An entry in a resource detail view's app links menu that opens a read-only results panel. It never writes to the cluster; the name `rowActions` is reserved for declared mutations.",
      "properties": {
        "capability": {
          "type": "string"
        },
        "forKinds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "capability",
        "forKinds",
        "id",
        "title"
      ],
      "type": "object"
    },
    "DetailPanel": {
      "additionalProperties": false,
      "properties": {
        "forKinds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/definitions/DetailSection"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "forKinds",
        "id",
        "sections",
        "title"
      ],
      "type": "object"
    },
    "DetailSection": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "fields": {
              "items": {
                "$ref": "#/definitions/DetailField"
              },
              "type": "array"
            },
            "type": {
              "enum": [
                "fields"
              ],
              "type": "string"
            }
          },
          "required": [
            "fields",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "join": {
              "type": [
                "string",
                "null"
              ]
            },
            "jsonPath": {
              "type": "string"
            },
            "type": {
              "enum": [
                "conditions"
              ],
              "type": "string"
            }
          },
          "required": [
            "jsonPath",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "DetailTab": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": "string"
        },
        "forKinds": {
          "description": "Qualified Kubernetes kinds, e.g. argoproj.io/Application.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "capability",
        "forKinds",
        "id",
        "title"
      ],
      "type": "object"
    },
    "Installed": {
      "additionalProperties": false,
      "properties": {
        "contexts": {
          "description": "The keys of the kubeconfig contexts the app is enabled for (`ResolvedContext::key`: `{file}#{name}` with `#` and `%` encoded in each part, as `k8s.listContexts` reports under `key`); `None` is every cluster. A context's display name is not identity: it changes when another kubeconfig declares the same name (#265). A stable ID is not either: `a` + `b#c` and `a#b` + `c` share one (#623).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "grants": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "history": {
          "description": "The versions this one replaced, newest first, at most [`KEPT_VERSIONS`].",
          "items": {
            "$ref": "#/definitions/PreviousVersion"
          },
          "type": "array"
        },
        "installedAt": {
          "description": "When this version was installed, in seconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "manifest": {
          "$ref": "#/definitions/Manifest"
        },
        "policyBlocked": {
          "description": "Recomputed policy denial, distinct from a failed publisher verification.",
          "type": [
            "string",
            "null"
          ]
        },
        "quarantined": {
          "description": "Why this host refused to trust the stored entry when loading it. Recomputed on every read, reported to the UI, and never written to disk.",
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "settings": {
          "additionalProperties": true,
          "type": "object"
        },
        "signatureProof": {
          "anyOf": [
            {
              "$ref": "#/definitions/SignatureProof"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/definitions/Source"
        }
      },
      "required": [
        "enabled",
        "grants",
        "history",
        "installedAt",
        "manifest",
        "revision",
        "settings",
        "source"
      ],
      "type": "object"
    },
    "Join": {
      "additionalProperties": false,
      "description": "A single granted custom-resource list used to enrich native table rows.",
      "properties": {
        "capability": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "match": {
          "$ref": "#/definitions/JoinMatch"
        }
      },
      "required": [
        "capability",
        "id",
        "match"
      ],
      "type": "object"
    },
    "JoinMatch": {
      "additionalProperties": false,
      "properties": {
        "annotation": {
          "type": [
            "string",
            "null"
          ]
        },
        "kindLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "boolean"
        },
        "ownerReference": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Manifest": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "description": "Editor metadata: the JSON Schema the manifest is written against. The host ignores it; it is the one key allowed that is not part of the contract.",
          "type": [
            "string",
            "null"
          ]
        },
        "actions": {
          "description": "Declared mutations (#549). Absent in a manifest that only reads, and left out of the serialized form when empty so a manifest stored and signed without it still round-trips to its own bytes.",
          "items": {
            "$ref": "#/definitions/ActionBinding"
          },
          "type": "array"
        },
        "capabilities": {
          "items": {
            "$ref": "#/definitions/Binding"
          },
          "type": "array"
        },
        "contributions": {
          "$ref": "#/definitions/Contributions"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ManifestKind"
        },
        "name": {
          "type": "string"
        },
        "permissions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "srelensApiVersion": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "capabilities",
        "contributions",
        "id",
        "kind",
        "name",
        "permissions",
        "srelensApiVersion",
        "version"
      ],
      "type": "object"
    },
    "ManifestKind": {
      "description": "Only data is executable in this first host. Code-bearing manifests must go through the future sandboxed runtime, never through a permissive fallback.",
      "enum": [
        "declarative"
      ],
      "type": "string"
    },
    "NormalizedStatus": {
      "description": "The six statuses every surface knows how to draw.",
      "enum": [
        "healthy",
        "warning",
        "error",
        "progressing",
        "suspended",
        "unknown"
      ],
      "type": "string"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": "string"
        },
        "dashboard": {
          "anyOf": [
            {
              "$ref": "#/definitions/Dashboard"
            },
            {
              "type": "null"
            }
          ]
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "statusColumns": {
          "anyOf": [
            {
              "$ref": "#/definitions/StatusColumns"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "capability",
        "id",
        "title"
      ],
      "type": "object"
    },
    "Predicate": {
      "additionalProperties": false,
      "description": "One declared check about the object an action would write.\n\nExactly one operator per predicate:\n\n```json {\"jsonPath\": \".spec.suspend\", \"notEquals\": true, \"reason\": \"Resume this resource before requesting reconciliation\"} ```",
      "properties": {
        "absent": {
          "description": "`true`: the value at `jsonPath` must be unset or null.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "equals": {
          "description": "The value at `jsonPath` must equal this literal."
        },
        "jsonPath": {
          "description": "The value this predicate asks about, as a bounded JSONPath subset: `.spec.suspend`, `.metadata.annotations['acme.io/pinned']`, `.status.conditions[0].status`. The grammar is the bounded subset the module documents: no wildcard or recursive descent, and one filter form, `[?(@.type==\"Ready\")]`, that selects the first matching element.",
          "type": "string"
        },
        "notEquals": {
          "description": "The value at `jsonPath` must not equal this literal. An unset field is not equal to anything, so this holds when it is absent."
        },
        "present": {
          "description": "`true`: the value at `jsonPath` must be set and not null.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "description": "What the operator is told when this predicate does not hold. Untrusted display text: written by the app, and escaped by the host before anything draws it.",
          "type": "string"
        }
      },
      "required": [
        "jsonPath",
        "reason"
      ],
      "type": "object"
    },
    "PreviousVersion": {
      "additionalProperties": false,
      "description": "A version an update replaced, kept so it can be restored.",
      "properties": {
        "grants": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "installedAt": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "manifest": {
          "$ref": "#/definitions/Manifest"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "signatureProof": {
          "anyOf": [
            {
              "$ref": "#/definitions/SignatureProof"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/definitions/Source"
        }
      },
      "required": [
        "grants",
        "installedAt",
        "manifest",
        "revision",
        "source"
      ],
      "type": "object"
    },
    "SignatureProof": {
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "type": "string"
        },
        "signature": {
          "items": {
            "format": "uint8",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "manifest",
        "signature"
      ],
      "type": "object"
    },
    "Source": {
      "description": "Where an installed version came from. The host decides: `catalog` means the exact bytes of a release listed in the cached catalog, whoever submitted them.",
      "enum": [
        "local",
        "catalog"
      ],
      "type": "string"
    },
    "StatusColumns": {
      "additionalProperties": false,
      "properties": {
        "progressing": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ready": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "suspended": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "ready"
      ],
      "type": "object"
    },
    "StatusResolver": {
      "additionalProperties": false,
      "description": "Ordered rules that resolve the status of the custom resources of `forKinds`. The first rule whose conditions all hold is the status; when none does the host says `unknown`.",
      "properties": {
        "forKinds": {
          "description": "Qualified kinds of custom resources this app declares a reader for.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rules": {
          "items": {
            "$ref": "#/definitions/StatusRule"
          },
          "type": "array"
        }
      },
      "required": [
        "forKinds",
        "rules"
      ],
      "type": "object"
    },
    "StatusRule": {
      "additionalProperties": false,
      "description": "One rule: when every condition holds, the object has this status.",
      "properties": {
        "label": {
          "description": "The word shown. Required: colour is never the only signal.",
          "type": "string"
        },
        "reason": {
          "description": "Where in the object the reason is, e.g. `.status.conditions[?(@.type==\"Ready\")].message`.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/NormalizedStatus"
        },
        "when": {
          "description": "Every condition must hold. An empty list always holds, which is how a last, catch-all rule is written.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        }
      },
      "required": [
        "label",
        "status",
        "when"
      ],
      "type": "object"
    },
    "TableColumn": {
      "additionalProperties": false,
      "properties": {
        "filterable": {
          "type": "boolean"
        },
        "forKinds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "format": {
          "$ref": "#/definitions/ColumnFormat"
        },
        "id": {
          "type": "string"
        },
        "sortable": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/definitions/ColumnSource"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "forKinds",
        "format",
        "id",
        "source",
        "title"
      ],
      "type": "object"
    }
  },
  "properties": {
    "allowUnsignedApps": {
      "default": false,
      "type": "boolean"
    },
    "nextRevision": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "plugins": {
      "items": {
        "$ref": "#/definitions/Installed"
      },
      "type": "array"
    },
    "schemaVersion": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "nextRevision",
    "plugins",
    "schemaVersion"
  ],
  "title": "Inventory",
  "type": "object"
}
