      "required": [
        "version",
        "type",
        "data"
      ],
      "additionalProperties": false
    },
    "Code": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "Code"
        },
        "data": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 262144
            },
            "language": {
              "enum": [
                "yaml",
                "none"
              ]
            }
          },
          "required": [
            "text",
            "language"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "type",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
