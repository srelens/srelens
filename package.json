{
  "packageManager": "pnpm@11.24.0",
  "name": "srelens-tauri",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @srelens/desktop tauri dev",
    "tauri": "pnpm --filter @srelens/desktop tauri",
    "build": "pnpm --filter @srelens/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "node packages/lens-compat/build.mjs && vitest run --coverage && pnpm --filter @srelens/lens-compat test",
    "test:packages": "pnpm -r test"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "turbo": "^2.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x || 26.x"
  }
}
