          "barmancloud.cnpg.io/ObjectStore"
        ],
        "source": {
          "join": "objectstores-self",
          "jsonPath": ".spec.configuration.destinationPath"
        },
        "format": "text",
        "sortable": true
      },
      {
        "id": "objectstores-retention",
