  "capabilities": [
    {
      "name": "clusters",
      "title": "List Clusters",
      "target": "k8s.listCustomResource",
      "arguments": {
        "group": "postgresql.cnpg.io",
        "version": "v1",
        "plural": "clusters",
        "kind": "Cluster",
        "namespaced": true,
        "printerColumns": [
          {
            "name": "Instances",
            "jsonPath": ".status.instances",
            "type": "integer"
          },
          {
            "name": "Ready",
            "jsonPath": ".status.readyInstances",
            "type": "integer"
          },
          {
            "name": "Status",
            "jsonPath": ".status.phase",
            "type": "string"
          },
          {
            "name": "Primary",
            "jsonPath": ".status.currentPrimary",
            "type": "string"
          }
        ]
      },
      "inputs": [
        "context",
        "namespace"
      ]
    },
