    "statusResolvers": [
      {
        "forKinds": [
          "postgresql.cnpg.io/Cluster"
        ],
        "rules": [
          {
            "when": [
              {
                "jsonPath": ".metadata.annotations['cnpg.io/hibernation']",
                "equals": "on"
              }
            ],
            "status": "suspended",
            "label": "Hibernated"
          },
          {
            "when": [
              {
                "jsonPath": ".metadata.annotations['cnpg.io/fencedInstances']",
                "present": true
              }
            ],
            "status": "warning",
            "label": "Fenced"
          },
          {
            "when": [
              {
                "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status",
                "equals": "False"
              }
            ],
            "status": "warning",
            "label": "Not ready",
            "reason": ".status.phase"
          },
          {
            "when": [
              {
                "jsonPath": ".status.conditions[?(@.type==\"ContinuousArchiving\")].status",
                "equals": "False"
              }
            ],
            "status": "warning",
            "label": "WAL archiving failing",
            "reason": ".status.conditions[?(@.type==\"ContinuousArchiving\")].message"
          },
          {
            "when": [
              {
                "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status",
                "equals": "True"
              }
            ],
            "status": "healthy",
            "label": "Healthy",
            "reason": ".status.phase"
          },
          {
            "when": [],
            "status": "unknown",
            "label": "Unknown"
          }
        ]
      },
      {
        "forKinds": [
          "postgresql.cnpg.io/Backup"
        ],
        "rules": [
          {
            "when": [
              {
                "jsonPath": ".status.phase",
                "equals": "completed"
              }
            ],
            "status": "healthy",
            "label": "Completed"
          },
          {
            "when": [
              {
                "jsonPath": ".status.phase",
                "equals": "failed"
              }
            ],
            "status": "error",
            "label": "Failed",
            "reason": ".status.error"
          },
          {
            "when": [
              {
                "jsonPath": ".status.phase",
                "equals": "walArchivingFailing"
              }
            ],
            "status": "error",
            "label": "WAL archiving failing",
            "reason": ".status.error"
          },
          {
            "when": [
              {
                "jsonPath": ".status.phase",
                "equals": "running"
              }
            ],
            "status": "progressing",
            "label": "Running"
          },
          {
            "when": [
              {
                "jsonPath": ".status.phase",
                "equals": "started"
              }
            ],
            "status": "progressing",
            "label": "Started"
          },
          {
            "when": [
              {
                "jsonPath": ".status.phase",
                "equals": "finalizing"
              }
            ],
            "status": "progressing",
            "label": "Finalizing"
          },
          {
            "when": [
              {
                "jsonPath": ".status.phase",
                "equals": "pending"
              }
            ],
            "status": "progressing",
            "label": "Pending"
          },
          {
            "when": [],
            "status": "unknown",
            "label": "Unknown"
          }
        ]
      },
      {
        "forKinds": [
          "postgresql.cnpg.io/ScheduledBackup"
        ],
        "rules": [
          {
            "when": [
              {
                "jsonPath": ".spec.suspend",
                "equals": true
              }
            ],
            "status": "suspended",
            "label": "Suspended"
          },
          {
            "when": [
              {
                "jsonPath": ".status.lastScheduleTime",
                "present": true
              }
            ],
            "status": "healthy",
            "label": "Active"
          },
          {
            "when": [],
            "status": "progressing",
            "label": "Not yet run"
          }
        ]
      },
      {
        "forKinds": [
          "postgresql.cnpg.io/Pooler"
        ],
        "rules": [
          {
            "when": [
              {
                "jsonPath": ".status.phase",
                "equals": "failed"
              }
            ],
            "status": "error",
            "label": "Failed",
            "reason": ".status.phaseReason"
          },
          {
            "when": [
              {
                "jsonPath": ".status.phase",
                "equals": "inactive"
              }
            ],
            "status": "warning",
            "label": "Inactive",
            "reason": ".status.phaseReason"
          },
          {
            "when": [
              {
                "jsonPath": ".status.phase",
                "equals": "paused"
              }
            ],
            "status": "suspended",
            "label": "Paused",
            "reason": ".status.phaseReason"
          },
          {
            "when": [
              {
                "jsonPath": ".status.phase",
                "equals": "active"
              }
            ],
            "status": "healthy",
            "label": "Active"
          },
          {
            "when": [],
            "status": "unknown",
            "label": "Unknown"
          }
        ]
      },
      {
        "forKinds": [
          "postgresql.cnpg.io/Database",
          "postgresql.cnpg.io/DatabaseRole",
          "postgresql.cnpg.io/Publication",
          "postgresql.cnpg.io/Subscription"
        ],
        "rules": [
          {
            "when": [
              {
                "jsonPath": ".status.applied",
                "equals": true
              }
            ],
            "status": "healthy",
            "label": "Applied"
          },
          {
            "when": [
              {
                "jsonPath": ".status.applied",
                "equals": false
              }
            ],
            "status": "error",
            "label": "Not applied",
            "reason": ".status.message"
          },
          {
            "when": [],
            "status": "progressing",
            "label": "Pending"
          }
        ]
      }
    ],
