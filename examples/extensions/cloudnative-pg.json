  "actions": [
    {
      "name": "restart",
      "title": "Restart",
      "target": "k8s.annotate",
      "resource": "clusters",
      "arguments": {
        "key": "kubectl.kubernetes.io/restartedAt",
        "value": "$now"
      }
    },
    {
      "name": "reload",
      "title": "Reload configuration",
      "target": "k8s.annotate",
      "resource": "clusters",
      "arguments": {
        "key": "cnpg.io/reloadedAt",
        "value": "$now"
      }
    },
    {
      "name": "hibernate",
      "title": "Hibernate",
      "target": "k8s.mergePatch",
      "resource": "clusters",
      "arguments": {
        "patch": {
          "metadata": {
            "annotations": {
              "cnpg.io/hibernation": "on"
            }
          }
        }
      },
      "preconditions": [
        {
          "jsonPath": ".metadata.annotations['cnpg.io/hibernation']",
          "notEquals": "on",
          "reason": "This cluster is already hibernated"
        }
      ],
      "availableWhen": [
        {
          "jsonPath": ".metadata.annotations['cnpg.io/hibernation']",
          "notEquals": "on",
          "reason": "This cluster is already hibernated"
        }
      ]
    },
    {
      "name": "wake",
      "title": "Wake up",
      "target": "k8s.mergePatch",
      "resource": "clusters",
      "arguments": {
        "patch": {
          "metadata": {
            "annotations": {
              "cnpg.io/hibernation": "off"
            }
          }
        }
      },
      "preconditions": [
        {
          "jsonPath": ".metadata.annotations['cnpg.io/hibernation']",
          "equals": "on",
          "reason": "This cluster is not hibernated"
        }
      ],
      "availableWhen": [
        {
          "jsonPath": ".metadata.annotations['cnpg.io/hibernation']",
          "equals": "on",
          "reason": "This cluster is not hibernated"
        }
      ]
    },
    {
      "name": "start-maintenance",
      "title": "Start node maintenance",
      "target": "k8s.setFields",
      "resource": "clusters",
      "arguments": {
        "fields": {
          "/spec/nodeMaintenanceWindow/inProgress": true
        }
      },
      "preconditions": [
        {
          "jsonPath": ".spec.nodeMaintenanceWindow.inProgress",
          "notEquals": true,
          "reason": "A maintenance window is already in progress"
        }
      ],
      "availableWhen": [
        {
          "jsonPath": ".spec.nodeMaintenanceWindow.inProgress",
          "notEquals": true,
          "reason": "A maintenance window is already in progress"
        }
      ]
    },
    {
      "name": "end-maintenance",
      "title": "End node maintenance",
      "target": "k8s.setFields",
      "resource": "clusters",
      "arguments": {
        "fields": {
          "/spec/nodeMaintenanceWindow/inProgress": false
        }
      },
      "preconditions": [
        {
          "jsonPath": ".spec.nodeMaintenanceWindow.inProgress",
          "equals": true,
          "reason": "No maintenance window is in progress"
        }
      ],
      "availableWhen": [
        {
          "jsonPath": ".spec.nodeMaintenanceWindow.inProgress",
          "equals": true,
          "reason": "No maintenance window is in progress"
        }
      ]
    },
    {
      "name": "suspend-backups",
      "title": "Suspend",
      "target": "k8s.setFields",
      "resource": "scheduledbackups",
      "arguments": {
        "fields": {
          "/spec/suspend": true
        }
      },
      "preconditions": [
        {
          "jsonPath": ".spec.suspend",
          "notEquals": true,
          "reason": "This scheduled backup is already suspended"
        }
      ],
      "availableWhen": [
        {
          "jsonPath": ".spec.suspend",
          "notEquals": true,
          "reason": "This scheduled backup is already suspended"
        }
      ]
    },
    {
      "name": "resume-backups",
      "title": "Resume",
      "target": "k8s.setFields",
      "resource": "scheduledbackups",
      "arguments": {
        "fields": {
          "/spec/suspend": false
        }
      },
      "preconditions": [
        {
          "jsonPath": ".spec.suspend",
          "equals": true,
          "reason": "This scheduled backup is not suspended"
        }
      ],
      "availableWhen": [
        {
          "jsonPath": ".spec.suspend",
          "equals": true,
          "reason": "This scheduled backup is not suspended"
        }
      ]
    },
    {
      "name": "pause-pooler",
      "title": "Pause",
      "target": "k8s.mergePatch",
      "resource": "poolers",
      "arguments": {
        "patch": {
          "spec": {
            "pgbouncer": {
              "paused": true
            }
          }
        }
      },
      "preconditions": [
        {
          "jsonPath": ".spec.pgbouncer.paused",
          "notEquals": true,
          "reason": "This pooler is already paused"
        }
      ],
      "availableWhen": [
        {
          "jsonPath": ".spec.pgbouncer.paused",
          "notEquals": true,
          "reason": "This pooler is already paused"
        }
      ]
    },
    {
      "name": "resume-pooler",
      "title": "Resume",
      "target": "k8s.mergePatch",
      "resource": "poolers",
      "arguments": {
        "patch": {
          "spec": {
            "pgbouncer": {
              "paused": false
            }
          }
        }
      },
      "preconditions": [
        {
          "jsonPath": ".spec.pgbouncer.paused",
          "equals": true,
          "reason": "This pooler is not paused"
        }
      ],
      "availableWhen": [
        {
          "jsonPath": ".spec.pgbouncer.paused",
          "equals": true,
          "reason": "This pooler is not paused"
        }
      ]
    }
  ]
