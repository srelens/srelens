{
  "$schema": "https://raw.githubusercontent.com/srelens/srelens/main/schemas/extension-manifest.v0.5.json",
  "id": "org.srelens.cloudnative-pg",
  "name": "CloudNativePG",
  "version": "0.1.0",
  "srelensApiVersion": "^0.5",
  "kind": "declarative",
  "permissions": [
    "k8s.listCustomResource",
    "k8s.listEvents",
    "k8s.setFields",
    "k8s.annotate",
    "k8s.mergePatch"
