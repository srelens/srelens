{
  "$schema": "https://raw.githubusercontent.com/srelens/srelens/main/schemas/extension-manifest.v0.5.json",
  "id": "org.srelens.external-secrets",
  "name": "External Secrets",
  "version": "0.1.0",
  "srelensApiVersion": "^0.5",
  "kind": "declarative",
  "permissions": [
    "k8s.listCustomResource",
    "k8s.listEvents",
    "k8s.annotate"
  ],
  "capabilities": [
    {
      "name": "externalsecrets",
      "title": "List External secrets",
      "target": "k8s.listCustomResource",
      "versions": [
        "v1",
        "v1beta1"
      ],
      "arguments": {
        "group": "external-secrets.io",
        "plural": "externalsecrets",
        "kind": "ExternalSecret",
        "namespaced": true,
        "printerColumns": [
          {
            "name": "StoreType",
            "jsonPath": ".spec.secretStoreRef.kind",
            "type": "string"
          },
          {
            "name": "Store",
            "jsonPath": ".spec.secretStoreRef.name",
            "type": "string"
          },
          {
            "name": "Refresh Interval",
            "jsonPath": ".spec.refreshInterval",
            "type": "string"
          },
          {
            "name": "Status",
            "jsonPath": ".status.conditions[?(@.type==\"Ready\")].reason",
            "type": "string"
          },
          {
            "name": "Ready",
            "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status",
            "type": "string"
          },
          {
            "name": "Last Sync",
            "jsonPath": ".status.refreshTime",
            "type": "date"
          }
        ]
      },
      "inputs": [
        "context",
        "namespace"
      ]
    },
    {
      "name": "clusterexternalsecrets",
      "title": "List Cluster external secrets",
      "target": "k8s.listCustomResource",
      "versions": [
        "v1",
        "v1beta1"
      ],
      "arguments": {
        "group": "external-secrets.io",
        "plural": "clusterexternalsecrets",
        "kind": "ClusterExternalSecret",
        "namespaced": false,
        "printerColumns": [
          {
            "name": "Store",
            "jsonPath": ".spec.externalSecretSpec.secretStoreRef.name",
            "type": "string"
          },
          {
            "name": "Refresh Interval",
            "jsonPath": ".spec.refreshTime",
            "type": "string"
          },
          {
            "name": "Ready",
            "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status",
            "type": "string"
          }
        ]
      },
      "inputs": [
        "context",
        "namespace"
      ]
    },
    {
      "name": "pushsecrets",
      "title": "List Push secrets",
      "target": "k8s.listCustomResource",
      "arguments": {
        "group": "external-secrets.io",
        "version": "v1alpha1",
        "plural": "pushsecrets",
        "kind": "PushSecret",
        "namespaced": true,
        "printerColumns": [
          {
            "name": "Status",
            "jsonPath": ".status.conditions[?(@.type==\"Ready\")].reason",
            "type": "string"
          },
          {
            "name": "Last Sync",
            "jsonPath": ".status.refreshTime",
            "type": "date"
          }
        ]
      },
      "inputs": [
        "context",
        "namespace"
      ]
    },
    {
      "name": "secretstores",
      "title": "List Secret stores",
      "target": "k8s.listCustomResource",
      "versions": [
        "v1",
        "v1beta1"
      ],
      "arguments": {
        "group": "external-secrets.io",
        "plural": "secretstores",
        "kind": "SecretStore",
        "namespaced": true,
        "printerColumns": [
          {
            "name": "Status",
            "jsonPath": ".status.conditions[?(@.type==\"Ready\")].reason",
            "type": "string"
          },
          {
            "name": "Capabilities",
            "jsonPath": ".status.capabilities",
            "type": "string"
          },
          {
            "name": "Ready",
            "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status",
            "type": "string"
          }
        ]
      },
      "inputs": [
        "context",
        "namespace"
      ]
    },
    {
      "name": "clustersecretstores",
      "title": "List Cluster secret stores",
      "target": "k8s.listCustomResource",
      "versions": [
        "v1",
        "v1beta1"
      ],
      "arguments": {
        "group": "external-secrets.io",
        "plural": "clustersecretstores",
        "kind": "ClusterSecretStore",
        "namespaced": false,
        "printerColumns": [
          {
            "name": "Status",
            "jsonPath": ".status.conditions[?(@.type==\"Ready\")].reason",
            "type": "string"
          },
          {
            "name": "Capabilities",
            "jsonPath": ".status.capabilities",
            "type": "string"
          },
          {
            "name": "Ready",
            "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status",
            "type": "string"
          }
        ]
      },
      "inputs": [
        "context",
        "namespace"
      ]
    },
    {
      "name": "events",
      "title": "List events",
      "target": "k8s.listEvents",
      "arguments": {},
      "inputs": [
        "context",
        "namespace"
      ]
    }
  ],
  "contributions": {
    "pages": [
      {
        "id": "overview",
        "title": "Overview",
        "capability": "externalsecrets",
        "dashboard": {
          "pages": [
            "externalsecrets",
            "pushsecrets",
            "clusterexternalsecrets",
            "secretstores",
            "clustersecretstores"
          ],
          "events": {
            "capability": "events",
            "apiGroups": [
              "external-secrets.io"
            ]
          }
        }
      },
      {
        "id": "externalsecrets",
        "title": "External secrets",
        "capability": "externalsecrets"
      },
      {
        "id": "clusterexternalsecrets",
        "title": "Cluster external secrets",
        "capability": "clusterexternalsecrets"
      },
      {
        "id": "pushsecrets",
        "title": "Push secrets",
        "capability": "pushsecrets"
      },
      {
        "id": "secretstores",
        "title": "Secret stores",
        "capability": "secretstores",
        "group": "Stores"
      },
      {
        "id": "clustersecretstores",
        "title": "Cluster secret stores",
        "capability": "clustersecretstores",
        "group": "Stores"
      }
    ],
    "detailPanels": [
      {
        "id": "externalsecret-summary",
        "title": "External secret",
        "forKinds": [
          "external-secrets.io/ExternalSecret"
        ],
        "sections": [
          {
            "type": "fields",
            "fields": [
              {
                "label": "Store",
                "jsonPath": ".spec.secretStoreRef.name"
              },
              {
                "label": "Store kind",
                "jsonPath": ".spec.secretStoreRef.kind"
              },
              {
                "label": "Target secret",
                "jsonPath": ".status.binding.name"
              },
              {
                "label": "Refresh interval",
                "jsonPath": ".spec.refreshInterval"
              },
              {
                "label": "Refresh policy",
                "jsonPath": ".spec.refreshPolicy"
              },
              {
                "label": "Creation policy",
                "jsonPath": ".spec.target.creationPolicy"
              },
              {
                "label": "Deletion policy",
                "jsonPath": ".spec.target.deletionPolicy"
              },
              {
                "label": "Last sync",
                "jsonPath": ".status.refreshTime",
                "format": "date"
              },
              {
                "label": "Synced resource version",
                "jsonPath": ".status.syncedResourceVersion"
              }
            ]
          }
        ]
      },
      {
        "id": "clusterexternalsecret-summary",
        "title": "Cluster external secret",
        "forKinds": [
          "external-secrets.io/ClusterExternalSecret"
        ],
        "sections": [
          {
            "type": "fields",
            "fields": [
              {
                "label": "External secret name",
                "jsonPath": ".spec.externalSecretName"
              },
              {
                "label": "Store",
                "jsonPath": ".spec.externalSecretSpec.secretStoreRef.name"
              },
              {
                "label": "Store kind",
                "jsonPath": ".spec.externalSecretSpec.secretStoreRef.kind"
              },
              {
                "label": "Refresh time",
                "jsonPath": ".spec.refreshTime"
              },
              {
                "label": "Refresh interval",
                "jsonPath": ".spec.externalSecretSpec.refreshInterval"
              }
            ]
          }
        ]
      },
      {
        "id": "pushsecret-summary",
        "title": "Push secret",
        "forKinds": [
          "external-secrets.io/PushSecret"
        ],
        "sections": [
          {
            "type": "fields",
            "fields": [
              {
                "label": "Source secret",
                "jsonPath": ".spec.selector.secret.name"
              },
              {
                "label": "Refresh interval",
                "jsonPath": ".spec.refreshInterval"
              },
              {
                "label": "Update policy",
                "jsonPath": ".spec.updatePolicy"
              },
              {
                "label": "Deletion policy",
                "jsonPath": ".spec.deletionPolicy"
              },
              {
                "label": "Last sync",
                "jsonPath": ".status.refreshTime",
                "format": "date"
              }
            ]
          }
        ]
      },
      {
        "id": "secretstore-summary",
        "title": "Secret store",
        "forKinds": [
          "external-secrets.io/SecretStore",
          "external-secrets.io/ClusterSecretStore"
        ],
        "sections": [
          {
            "type": "fields",
            "fields": [
              {
                "label": "Capabilities",
                "jsonPath": ".status.capabilities"
              },
              {
                "label": "Controller",
                "jsonPath": ".spec.controller"
              },
              {
                "label": "Refresh interval (s)",
                "jsonPath": ".spec.refreshInterval",
                "format": "number"
              },
              {
                "label": "Retries",
                "jsonPath": ".spec.retrySettings.maxRetries",
                "format": "number"
              }
            ]
          }
        ]
      },
      {
        "id": "external-secrets-conditions",
        "title": "Conditions",
        "forKinds": [
          "external-secrets.io/ExternalSecret",
          "external-secrets.io/ClusterExternalSecret",
          "external-secrets.io/PushSecret",
          "external-secrets.io/SecretStore",
          "external-secrets.io/ClusterSecretStore"
        ],
        "sections": [
          {
            "type": "conditions",
            "jsonPath": ".status.conditions"
          }
        ]
      }
    ],
    "detailTabs": [],
    "detailLinks": [],
    "commands": [
      {
        "id": "open-overview",
        "title": "Open overview",
        "target": {
          "page": "overview"
        }
      },
      {
        "id": "open-externalsecrets",
        "title": "Open external secrets",
        "target": {
          "page": "externalsecrets"
        }
      },
      {
        "id": "open-clusterexternalsecrets",
        "title": "Open cluster external secrets",
        "target": {
          "page": "clusterexternalsecrets"
        }
      },
      {
        "id": "open-pushsecrets",
        "title": "Open push secrets",
        "target": {
          "page": "pushsecrets"
        }
      },
      {
        "id": "open-secretstores",
        "title": "Open secret stores",
        "target": {
          "page": "secretstores"
        }
      },
      {
        "id": "open-clustersecretstores",
        "title": "Open cluster secret stores",
        "target": {
          "page": "clustersecretstores"
        }
      },
      {
        "id": "force-sync",
        "title": "Force sync",
        "target": {
          "action": "force-sync"
        },
        "forKinds": [
          "external-secrets.io/ExternalSecret"
        ]
      }
    ],
    "statusResolvers": [
      {
        "forKinds": [
          "external-secrets.io/ExternalSecret",
          "external-secrets.io/PushSecret",
          "external-secrets.io/ClusterExternalSecret"
        ],
        "rules": [
          {
            "when": [
              {
                "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status",
                "equals": "True"
              }
            ],
            "status": "healthy",
            "label": "Synced"
          },
          {
            "when": [
              {
                "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status",
                "equals": "False"
              }
            ],
            "status": "error",
            "label": "Sync failed",
            "reason": ".status.conditions[?(@.type==\"Ready\")].message"
          },
          {
            "when": [],
            "status": "unknown",
            "label": "Unknown"
          }
        ]
      },
      {
        "forKinds": [
          "external-secrets.io/SecretStore",
          "external-secrets.io/ClusterSecretStore"
        ],
        "rules": [
          {
            "when": [
              {
                "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status",
                "equals": "True"
              }
            ],
            "status": "healthy",
            "label": "Valid"
          },
          {
            "when": [
              {
                "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status",
                "equals": "False"
              }
            ],
            "status": "error",
            "label": "Invalid",
            "reason": ".status.conditions[?(@.type==\"Ready\")].message"
          },
          {
            "when": [],
            "status": "unknown",
            "label": "Unknown"
          }
        ]
      }
    ],
    "dashboardCards": [
      {
        "id": "externalsecrets-by-status",
        "title": "External secrets by status",
        "size": "m",
        "type": "countByStatus",
        "source": "externalsecrets",
        "target": {
          "page": "externalsecrets"
        }
      },
      {
        "id": "externalsecrets-failed",
        "title": "External secrets failing to sync",
        "size": "s",
        "type": "count",
        "source": "externalsecrets",
        "predicate": {
          "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status",
          "equals": "False"
        },
        "target": {
          "page": "externalsecrets"
        }
      },
      {
        "id": "pushsecrets-by-status",
        "title": "Push secrets by status",
        "size": "m",
        "type": "countByStatus",
        "source": "pushsecrets",
        "target": {
          "page": "pushsecrets"
        }
      },
      {
        "id": "secretstores-by-status",
        "title": "Secret stores by status",
        "size": "m",
        "type": "countByStatus",
        "source": "secretstores",
        "target": {
          "page": "secretstores"
        }
      },
      {
        "id": "clustersecretstores-invalid",
        "title": "Invalid cluster secret stores",
        "size": "s",
        "type": "count",
        "source": "clustersecretstores",
        "predicate": {
          "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status",
          "equals": "False"
        },
        "target": {
          "page": "clustersecretstores"
        }
      }
    ],
    "resourceLinks": [
      {
        "id": "externalsecret-secret",
        "from": "external-secrets.io/ExternalSecret",
        "to": "/Secret",
        "relation": "references",
        "match": {
          "path": ".status.binding"
        }
      },
      {
        "id": "externalsecret-store",
        "from": "external-secrets.io/ExternalSecret",
        "to": "external-secrets.io/SecretStore",
        "relation": "references",
        "match": {
          "path": ".spec.secretStoreRef"
        }
      },
      {
        "id": "externalsecret-cluster-store",
        "from": "external-secrets.io/ExternalSecret",
        "to": "external-secrets.io/ClusterSecretStore",
        "relation": "references",
        "match": {
          "path": ".spec.secretStoreRef"
        }
      },
      {
        "id": "pushsecret-secret",
        "from": "external-secrets.io/PushSecret",
        "to": "/Secret",
        "relation": "references",
        "match": {
          "path": ".spec.selector.secret"
        }
      },
      {
        "id": "pushsecret-store",
        "from": "external-secrets.io/PushSecret",
        "to": "external-secrets.io/SecretStore",
        "relation": "references",
        "match": {
          "path": ".spec.secretStoreRefs[*]"
        }
      },
      {
        "id": "pushsecret-cluster-store",
        "from": "external-secrets.io/PushSecret",
        "to": "external-secrets.io/ClusterSecretStore",
        "relation": "references",
        "match": {
          "path": ".spec.secretStoreRefs[*]"
        }
      }
    ]
  },
  "actions": [
    {
      "name": "force-sync",
      "title": "Force sync",
      "target": "k8s.annotate",
      "resource": "externalsecrets",
      "arguments": {
        "key": "external-secrets.io/force-sync",
        "value": "$now"
      }
    }
  ]
}
