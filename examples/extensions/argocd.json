{
  "$schema": "https://raw.githubusercontent.com/srelens/srelens/main/schemas/extension-manifest.v0.3.json",
  "id": "org.srelens.argocd",
  "name": "Argo CD",
  "version": "0.4.0",
  "srelensApiVersion": "^0.3",
  "kind": "declarative",
  "permissions": [
    "k8s.listCustomResource",
    "k8s.annotate",
    "k8s.mergePatch"
  ],
  "capabilities": [
    {
      "name": "applications",
      "title": "List Applications",
      "target": "k8s.listCustomResource",
      "arguments": {
        "group": "argoproj.io",
        "version": "v1alpha1",
        "plural": "applications",
        "kind": "Application",
        "namespaced": true,
        "printerColumns": [
          {
            "name": "Health",
            "jsonPath": ".status.health.status",
            "type": "string"
          },
          {
            "name": "Sync",
            "jsonPath": ".status.sync.status",
            "type": "string"
          }
        ]
      },
      "inputs": [
        "context",
        "namespace"
      ]
    }
  ],
  "contributions": {
    "pages": [
      {
        "id": "applications",
        "title": "Applications",
        "capability": "applications"
      }
    ],
    "detailPanels": [
      {
        "id": "application-summary",
        "title": "Application",
        "forKinds": ["argoproj.io/Application"],
        "sections": [
          {"type": "fields", "fields": [
            {"label": "Project", "jsonPath": ".spec.project"},
            {"label": "Repository", "jsonPath": ".spec.source.repoURL"},
            {"label": "Path", "jsonPath": ".spec.source.path"},
            {"label": "Destination namespace", "jsonPath": ".spec.destination.namespace"},
            {"label": "Health", "jsonPath": ".status.health.status", "format": "status"},
            {"label": "Sync", "jsonPath": ".status.sync.status", "format": "status"}
          ]}
        ]
      }
    ],
    "detailTabs": [
      {
        "id": "namespace-resources",
        "title": "Argo CD",
        "capability": "applications",
        "forKinds": [
          "/Namespace"
        ]
      }
    ],
    "detailLinks": [
      {
        "id": "inspect-namespace",
        "title": "Inspect Argo CD resources",
        "capability": "applications",
        "forKinds": [
          "/Namespace"
        ]
      }
    ],
    "commands": [
      {
        "id": "open-applications",
        "title": "Open applications",
        "target": {
          "page": "applications"
        }
      },
      {
        "id": "sync",
        "title": "Sync application",
        "target": {
          "action": "sync"
        },
        "forKinds": [
          "argoproj.io/Application"
        ]
      },
      {
        "id": "refresh",
        "title": "Refresh application status",
        "target": {
          "action": "refresh"
        },
        "forKinds": [
          "argoproj.io/Application"
        ]
      }
    ],
    "statusResolvers": [
      {
        "forKinds": [
          "argoproj.io/Application"
        ],
        "rules": [
          {
            "when": [
              {
                "jsonPath": ".status.health.status",
                "equals": "Suspended"
              }
            ],
            "status": "suspended",
            "label": "Suspended",
            "reason": ".status.health.message"
          },
          {
            "when": [
              {
                "jsonPath": ".status.health.status",
                "equals": "Degraded"
              }
            ],
            "status": "error",
            "label": "Degraded",
            "reason": ".status.health.message"
          },
          {
            "when": [
              {
                "jsonPath": ".status.health.status",
                "equals": "Missing"
              }
            ],
            "status": "error",
            "label": "Missing",
            "reason": ".status.health.message"
          },
          {
            "when": [
              {
                "jsonPath": ".status.health.status",
                "equals": "Progressing"
              }
            ],
            "status": "progressing",
            "label": "Progressing",
            "reason": ".status.health.message"
          },
          {
            "when": [
              {
                "jsonPath": ".status.health.status",
                "equals": "Healthy"
              },
              {
                "jsonPath": ".status.sync.status",
                "equals": "OutOfSync"
              }
            ],
            "status": "warning",
            "label": "Out of sync",
            "reason": ".status.sync.revision"
          },
          {
            "when": [
              {
                "jsonPath": ".status.health.status",
                "equals": "Healthy"
              }
            ],
            "status": "healthy",
            "label": "Healthy"
          },
          {
            "when": [],
            "status": "unknown",
            "label": "Unknown"
          }
        ]
      }
    ],
    "badges": [
      {
        "id": "argocd-managed",
        "forKinds": [
          "apps/Deployment",
          "apps/StatefulSet",
          "apps/DaemonSet"
        ],
        "rules": [
          {
            "when": [
              {
                "jsonPath": ".metadata.annotations['argocd.argoproj.io/tracking-id']",
                "selfReference": "argocd-tracking-id"
              }
            ],
            "status": "healthy",
            "label": "Argo CD",
            "reason": ".metadata.annotations['argocd.argoproj.io/tracking-id']"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "name": "refresh",
      "title": "Refresh status",
      "target": "k8s.annotate",
      "resource": "applications",
      "arguments": {
        "key": "argocd.argoproj.io/refresh",
        "value": "normal"
      }
    },
    {
      "name": "hard-refresh",
      "title": "Hard refresh",
      "target": "k8s.annotate",
      "resource": "applications",
      "arguments": {
        "key": "argocd.argoproj.io/refresh",
        "value": "hard"
      }
    },
    {
      "name": "sync",
      "title": "Sync",
      "target": "k8s.mergePatch",
      "resource": "applications",
      "arguments": {
        "patch": {
          "operation": {
            "initiatedBy": {
              "username": "srelens"
            },
            "sync": {
              "prune": false,
              "syncStrategy": {
                "hook": {}
              }
            }
          }
        }
      },
      "preconditions": [
        {
          "jsonPath": ".operation",
          "absent": true,
          "reason": "An Argo CD operation is already in progress"
        }
      ],
      "availableWhen": [
        {
          "jsonPath": ".operation",
          "absent": true,
          "reason": "An Argo CD operation is already in progress"
        }
      ]
    }
  ]
}
