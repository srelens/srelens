        "id": "kustomization-summary",
        "title": "Kustomization",
        "forKinds": ["kustomize.toolkit.fluxcd.io/Kustomization"],
        "sections": [
          {"type": "fields", "fields": [
            {"label": "Source reference", "jsonPath": ".spec.sourceRef.name"},
            {"label": "Path", "jsonPath": ".spec.path"},
            {"label": "Suspended", "jsonPath": ".spec.suspend"},
            {"label": "Prune", "jsonPath": ".spec.prune"},
            {"label": "Wait for readiness", "jsonPath": ".spec.wait"}
          ]}
        ]
      },
      {
