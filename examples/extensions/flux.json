        "title": "Helm release",
        "forKinds": ["helm.toolkit.fluxcd.io/HelmRelease"],
        "sections": [
          {"type": "fields", "fields": [
            {"label": "Chart", "jsonPath": ".spec.chart.spec.chart"},
            {"label": "Version", "jsonPath": ".spec.chart.spec.version"},
            {"label": "Release name", "jsonPath": ".spec.releaseName"},
            {"label": "Suspended", "jsonPath": ".spec.suspend"},
            {"label": "Interval", "jsonPath": ".spec.interval"}
          ]}
        ]
      }
    ],
