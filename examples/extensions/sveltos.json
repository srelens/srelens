    "statusResolvers": [
      {
        "forKinds": [
          "lib.projectsveltos.io/SveltosCluster"
        ],
        "rules": [
          {
            "when": [
              {
                "jsonPath": ".spec.paused",
                "equals": true
              }
            ],
            "status": "suspended",
            "label": "Paused"
          },
          {
            "when": [
              {
                "jsonPath": ".status.connectionStatus",
                "equals": "Down"
              }
            ],
            "status": "error",
            "label": "Unreachable",
            "reason": ".status.failureMessage"
          },
          {
            "when": [
              {
                "jsonPath": ".status.ready",
                "equals": true
              }
            ],
            "status": "healthy",
            "label": "Ready"
          },
          {
            "when": [
              {
                "jsonPath": ".status.ready",
                "equals": false
              }
            ],
            "status": "error",
            "label": "Not ready",
            "reason": ".status.failureMessage"
          },
          {
            "when": [],
            "status": "unknown",
            "label": "Unknown"
          }
        ]
      },
      {
        "forKinds": [
          "config.projectsveltos.io/ClusterProfile",
          "config.projectsveltos.io/Profile"
        ],
        "rules": [
          {
            "when": [
              {
                "jsonPath": ".status.reconciliationSuspended",
                "equals": true
              }
            ],
            "status": "suspended",
            "label": "Suspended",
            "reason": ".status.suspensionReason"
          },
          {
            "when": [
              {
                "jsonPath": ".status.failedClusters[0]",
                "present": true
              }
            ],
            "status": "error",
            "label": "Failing on a cluster"
          },
          {
            "when": [
              {
                "jsonPath": ".status.updatingClusters.clusters[0]",
                "present": true
              }
            ],
            "status": "progressing",
            "label": "Updating clusters"
          },
          {
            "when": [
              {
                "jsonPath": ".status.matchingClusters[0]",
                "present": true
              }
            ],
            "status": "healthy",
            "label": "Matching clusters"
          },
          {
            "when": [],
            "status": "unknown",
            "label": "No matching clusters"
          }
        ]
      },
      {
        "forKinds": [
          "config.projectsveltos.io/ClusterSummary"
        ],
        "rules": [
          {
            "when": [
              {
                "jsonPath": ".status.reconciliationSuspended",
                "equals": true
              }
            ],
            "status": "suspended",
            "label": "Suspended",
            "reason": ".status.suspensionReason"
          },
          {
            "when": [
              {
                "jsonPath": ".status.featureSummaries[?(@.status==\"Failed\")].featureID",
                "present": true
              }
            ],
            "status": "error",
            "label": "Failed",
