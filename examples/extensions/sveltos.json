  "capabilities": [
    {
      "name": "sveltosclusters",
      "title": "List Clusters",
      "target": "k8s.listCustomResource",
      "arguments": {
        "group": "lib.projectsveltos.io",
        "version": "v1beta1",
        "plural": "sveltosclusters",
        "kind": "SveltosCluster",
        "namespaced": true,
        "printerColumns": [
          {
            "name": "Ready",
            "jsonPath": ".status.ready",
            "type": "boolean"
          },
          {
            "name": "ConnectionStatus",
            "jsonPath": ".status.connectionStatus",
            "type": "string"
          },
          {
            "name": "Version",
            "jsonPath": ".status.version",
            "type": "string"
          }
        ]
      },
      "inputs": [
        "context",
        "namespace"
      ]
    },
    {
      "name": "clusterprofiles",
