  "actions": [
    {
      "name": "pause-cluster",
      "title": "Pause",
      "target": "k8s.setFields",
      "resource": "sveltosclusters",
      "arguments": {
        "fields": {
          "/spec/paused": true
        }
      },
      "preconditions": [
        {
          "jsonPath": ".spec.paused",
          "notEquals": true,
          "reason": "This cluster is already paused"
        }
      ],
      "availableWhen": [
        {
          "jsonPath": ".spec.paused",
          "notEquals": true,
          "reason": "This cluster is already paused"
        }
      ]
    },
    {
      "name": "resume-cluster",
      "title": "Resume",
      "target": "k8s.setFields",
      "resource": "sveltosclusters",
      "arguments": {
        "fields": {
          "/spec/paused": false
        }
      },
      "preconditions": [
        {
          "jsonPath": ".spec.paused",
          "equals": true,
          "reason": "This cluster is not paused"
        }
      ],
      "availableWhen": [
        {
          "jsonPath": ".spec.paused",
          "equals": true,
