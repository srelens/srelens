    "statusResolvers": [
      {
        "forKinds": [
          "velero.io/Backup",
          "velero.io/Restore"
        ],
        "rules": [
          {
            "when": [
              {
                "jsonPath": ".status.phase",
                "equals": "Completed"
              }
            ],
            "status": "healthy",
            "label": "Completed"
          },
          {
            "when": [
              {
                "jsonPath": ".status.phase",
                "equals": "PartiallyFailed"
              }
            ],
            "status": "warning",
            "label": "Partially failed",
