  "actions": [
    {
      "name": "pause-schedule",
      "title": "Pause",
      "target": "k8s.setFields",
      "resource": "schedules",
      "arguments": {
        "fields": {
          "/spec/paused": true
        }
      },
      "preconditions": [
        {
          "jsonPath": ".spec.paused",
          "notEquals": true,
          "reason": "This schedule is already paused"
        }
      ],
      "availableWhen": [
        {
          "jsonPath": ".spec.paused",
          "notEquals": true,
          "reason": "This schedule is already paused"
        }
      ]
    },
    {
      "name": "resume-schedule",
      "title": "Resume",
      "target": "k8s.setFields",
      "resource": "schedules",
      "arguments": {
        "fields": {
          "/spec/paused": false
        }
      },
      "preconditions": [
        {
          "jsonPath": ".spec.paused",
          "equals": true,
          "reason": "This schedule is not paused"
        }
      ],
      "availableWhen": [
        {
          "jsonPath": ".spec.paused",
          "equals": true,
          "reason": "This schedule is not paused"
        }
      ]
    }
  ]
